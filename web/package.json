{
  "name": "tradoc-ui",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 2505",
    "dev:demo:lan": "vite --mode demo --host 0.0.0.0 --port 2505",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:demo": "node scripts/check-demo.mjs && npm run build:demo",
    "preview": "vite preview --host 127.0.0.1",
    "preview:lan": "vite preview --host 0.0.0.0",
    "preview:demo": "vite preview --host 127.0.0.1 --port 2505",
    "preview:demo:lan": "vite preview --host 0.0.0.0 --port 2505",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config playwright.demo.config.js",
    "demo:capture": "node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "4.3.3",
    "vite": "^8.2.1"
  }
}
