{
  "name": "tradoc-ui",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 2505",
    "dev:demo:lan": "vite --mode demo --host 0.0.0.0 --port 2505",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "check:demo": "node scripts/check-demo.mjs && npm run build:demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --host 127.0.0.1 --port 2505",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config playwright.demo.config.js"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2"
  }
}
