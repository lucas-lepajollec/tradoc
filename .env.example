ENV=production
DATA_DIR=./data

# Required for main.py dev --lan-secure or a non-loopback production server.
# Replace this example with a random value of at least 24 characters.
APP_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=

# LM Studio example. Use api_type=lm-studio for private/local endpoints.
LLM_ENDPOINT=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.5-9b
API_TYPE=lm-studio

CONCURRENCY=1
CHUNK_TOKEN_SIZE=1000
TEMPERATURE=0.15
MAX_RETRIES=3
REQUEST_TIMEOUT=180.0
MAX_UPLOAD_BYTES=209715200

DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=fr
