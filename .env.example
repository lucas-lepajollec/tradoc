# Config TraDoc - Traducteur Littéraire Local
ENV=production
DATA_DIR=./data

# LLM Remote GPU Server (LM Studio / Ollama / OpenAI spec)
LLM_ENDPOINT=http://192.168.0.201:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.5-9b
API_TYPE=openai # "openai" ou "ollama"

# Core Engine Tuning
CONCURRENCY=1
CHUNK_TOKEN_SIZE=1000
TEMPERATURE=1.50
MAX_RETRIES=3
REQUEST_TIMEOUT=180.0

DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=fr
